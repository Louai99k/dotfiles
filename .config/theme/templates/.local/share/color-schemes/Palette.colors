[General]
ColorScheme=Palette
Name=Palette

[WM]
activeBackground={{base_rgb}}
activeBlend={{text_rgb}}
activeForeground={{text_rgb}}
inactiveBackground={{base_rgb}}
inactiveBlend={{subtle_rgb}}
inactiveForeground={{subtle_rgb}}
