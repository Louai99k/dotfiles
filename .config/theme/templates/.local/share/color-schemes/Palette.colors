# KDE apps color scheme, rendered from ~/.config/theme/palette.conf.
# Merged into ~/.config/kdeglobals by scripts/general/theme.sh at login.

[ColorEffects:Disabled]
Color={{base_rgb}}
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
IntensityAmount=0.1
IntensityEffect=2

[ColorEffects:Inactive]
ChangeSelectionColor=false
Enable=false

[Colors:Button]
BackgroundAlternate={{hl_med_rgb}}
BackgroundNormal={{overlay_rgb}}
DecorationFocus={{accent_rgb}}
DecorationHover={{accent_rgb}}
ForegroundActive={{foam_rgb}}
ForegroundInactive={{subtle_rgb}}
ForegroundLink={{foam_rgb}}
ForegroundNegative={{love_rgb}}
ForegroundNeutral={{gold_rgb}}
ForegroundNormal={{text_rgb}}
ForegroundPositive={{foam_rgb}}
ForegroundVisited={{iris_rgb}}

[Colors:Complementary]
BackgroundAlternate={{surface_rgb}}
BackgroundNormal={{base_rgb}}
DecorationFocus={{accent_rgb}}
DecorationHover={{accent_rgb}}
ForegroundActive={{foam_rgb}}
ForegroundInactive={{subtle_rgb}}
ForegroundLink={{foam_rgb}}
ForegroundNegative={{love_rgb}}
ForegroundNeutral={{gold_rgb}}
ForegroundNormal={{text_rgb}}
ForegroundPositive={{foam_rgb}}
ForegroundVisited={{iris_rgb}}

[Colors:Header]
BackgroundAlternate={{surface_rgb}}
BackgroundNormal={{base_rgb}}
DecorationFocus={{accent_rgb}}
DecorationHover={{accent_rgb}}
ForegroundActive={{foam_rgb}}
ForegroundInactive={{subtle_rgb}}
ForegroundLink={{foam_rgb}}
ForegroundNegative={{love_rgb}}
ForegroundNeutral={{gold_rgb}}
ForegroundNormal={{text_rgb}}
ForegroundPositive={{foam_rgb}}
ForegroundVisited={{iris_rgb}}

[Colors:Header][Inactive]
BackgroundAlternate={{surface_rgb}}
BackgroundNormal={{base_rgb}}
DecorationFocus={{accent_rgb}}
DecorationHover={{accent_rgb}}
ForegroundActive={{foam_rgb}}
ForegroundInactive={{subtle_rgb}}
ForegroundLink={{foam_rgb}}
ForegroundNegative={{love_rgb}}
ForegroundNeutral={{gold_rgb}}
ForegroundNormal={{text_rgb}}
ForegroundPositive={{foam_rgb}}
ForegroundVisited={{iris_rgb}}

[Colors:Selection]
BackgroundAlternate={{hl_med_rgb}}
BackgroundNormal={{accent_rgb}}
DecorationFocus={{accent_rgb}}
DecorationHover={{accent_rgb}}
ForegroundActive={{base_rgb}}
ForegroundInactive={{overlay_rgb}}
ForegroundLink={{base_rgb}}
ForegroundNegative={{love_rgb}}
ForegroundNeutral={{gold_rgb}}
ForegroundNormal={{base_rgb}}
ForegroundPositive={{pine_rgb}}
ForegroundVisited={{overlay_rgb}}

[Colors:Tooltip]
BackgroundAlternate={{surface_rgb}}
BackgroundNormal={{overlay_rgb}}
DecorationFocus={{accent_rgb}}
DecorationHover={{accent_rgb}}
ForegroundActive={{foam_rgb}}
ForegroundInactive={{subtle_rgb}}
ForegroundLink={{foam_rgb}}
ForegroundNegative={{love_rgb}}
ForegroundNeutral={{gold_rgb}}
ForegroundNormal={{text_rgb}}
ForegroundPositive={{foam_rgb}}
ForegroundVisited={{iris_rgb}}

[Colors:View]
BackgroundAlternate={{hl_low_rgb}}
BackgroundNormal={{surface_rgb}}
DecorationFocus={{accent_rgb}}
DecorationHover={{accent_rgb}}
ForegroundActive={{foam_rgb}}
ForegroundInactive={{subtle_rgb}}
ForegroundLink={{foam_rgb}}
ForegroundNegative={{love_rgb}}
ForegroundNeutral={{gold_rgb}}
ForegroundNormal={{text_rgb}}
ForegroundPositive={{foam_rgb}}
ForegroundVisited={{iris_rgb}}

[Colors:Window]
