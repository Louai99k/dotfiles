#!/bin/env bash

SCRIPT_FOLDER="/home/luay/.local/bin-scripts/dcc"
DOCS_FOLDER="$SCRIPT_FOLDER/docs"
COMMAND=$1

shift

usage() {
  echo "Usage: dcc {master-db|master-db-restore|db-snapshot|db-restore|db-up|db-down|web|mobile} [options]"
  echo "Run dcc COMMAND -h for a command's documentation."
}

if [[ "$COMMAND" == "-h" || "$COMMAND" == "--help" ]]; then
  usage
  exit 0
fi

for arg in "$@"; do
  if [[ ("$arg" == "-h" || "$arg" == "--help") && "$COMMAND" != */* && -f "$DOCS_FOLDER/$COMMAND.md" ]]; then
    cat "$DOCS_FOLDER/$COMMAND.md"
    exit 0
  fi
done

case "$COMMAND" in
  db-snapshot)
    "$SCRIPT_FOLDER/snapshot-database.sh" "$@"
    ;;
  db-restore)
    "$SCRIPT_FOLDER/restore-database-snapshot.sh" "$@"
    ;;
  master-db)
    "$SCRIPT_FOLDER/download-master-db.sh" "$@"
    ;;
  master-db-restore)
    "$SCRIPT_FOLDER/restore-master-db.sh" "$@"
    ;;
  web)
    "$SCRIPT_FOLDER/web-tmux.sh"
    ;;
  mobile)
    "$SCRIPT_FOLDER/mobile-tmux.sh"
    ;;
  db-up)
    docker-compose -f /home/luay/me/childcare/_childcare/database-docker/docker-compose.yml up -d
    ;;
  db-down)
    docker-compose -f /home/luay/me/childcare/_childcare/database-docker/docker-compose.yml down
    ;;
  *)
    usage
    exit 1
    ;;
esac
